---
import BaseLayout from '../layouts/BaseLayout.astro';

interface SchemeProduct { name: string; art: string; price: string }
interface SchemePart { n: number; name: string; desc: string; icon: string; x: number; y: number; ax: number; ay: number; products: SchemeProduct[] }

const PARTS: SchemePart[] = [
  { n: 1, name: 'Манжета люка', desc: 'Уплотнение люка должно точно совпадать по диаметру и посадке бака.', icon: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/>', x: 84, y: 40, ax: 62, ay: 52, products: [
    { name: 'Манжета люка СМА Samsung DC64-00563B', art: 'DC64-00563B', price: '2 450 ₽' },
    { name: 'Манжета люка СМА LG MDS41955001', art: 'MDS41955001', price: '2 180 ₽' },
  ] },
  { n: 2, name: 'ТЭН (нагреватель)', desc: 'Мощность и длина должны совпадать с оригиналом (±10%).', icon: '<path d="M4 14c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><path d="M4 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>', x: 86, y: 55, ax: 60, ay: 66, products: [
    { name: 'ТЭН 1900W с датчиком СМА Samsung', art: 'WM1009SZw', price: '1 350 ₽' },
    { name: 'ТЭН 2000W СМА Bosch прямой', art: 'BS-2000-PR', price: '1 480 ₽' },
  ] },
  { n: 3, name: 'Сливной насос', desc: 'Проверьте крепление улитки и тип клемм перед заказом.', icon: '<circle cx="12" cy="12" r="8"/><path d="M12 4v4M12 16v4M4 12h4M16 12h4"/>', x: 47, y: 6, ax: 50, ay: 16, products: [
    { name: 'Насос слива Askoll 30W', art: 'PMP-ASK-01', price: '1 890 ₽' },
    { name: 'Насос слива Hanyu B13-6A', art: 'PMP-HAN-13', price: '1 650 ₽' },
  ] },
  { n: 4, name: 'Двигатель', desc: 'Коллекторный или инверторный — зависит от серии машины.', icon: '<rect width="16" height="12" x="4" y="6" rx="2"/><path d="M12 6V3M9 18v3M15 18v3"/>', x: 86, y: 82, ax: 62, ay: 84, products: [
    { name: 'Двигатель СМА Welling 300W', art: 'MTR-WL-300', price: '6 900 ₽' },
    { name: 'Щётки двигателя (комплект)', art: 'BR-SET-02', price: '540 ₽' },
  ] },
  { n: 5, name: 'Амортизаторы', desc: 'Меняются парой, усилие 80–120N по модели.', icon: '<path d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4"/>', x: 12, y: 86, ax: 38, ay: 88, products: [
    { name: 'Амортизатор СМА 100N (пара)', art: 'AMO-100N-2', price: '1 100 ₽' },
    { name: 'Амортизатор СМА Bosch 90N', art: 'BS-90N-01', price: '620 ₽' },
  ] },
  { n: 6, name: 'Приводной ремень', desc: 'Длина в маркировке: например 1195 J5.', icon: '<ellipse cx="12" cy="12" rx="9" ry="5"/><ellipse cx="12" cy="12" rx="4.5" ry="2"/>', x: 86, y: 69, ax: 63, ay: 74, products: [
    { name: 'Ремень 1195 J5 ELAST', art: 'BLT-1195J5', price: '480 ₽' },
    { name: 'Ремень 1280 J6', art: 'BLT-1280J6', price: '520 ₽' },
  ] },
  { n: 7, name: 'Модуль управления', desc: 'Прошивка привязана к модели — сверьте артикул.', icon: '<rect width="16" height="10" x="4" y="7" rx="2"/><path d="M8 11h3M13 11h.01M8 14h.01M12 14h4"/>', x: 84, y: 26, ax: 62, ay: 24, products: [
    { name: 'Модуль управления СМА Indesit EVO-II', art: 'MDL-EVO2-01', price: '4 750 ₽' },
    { name: 'Плата индикации СМА Samsung', art: 'PCB-SM-07', price: '2 300 ₽' },
  ] },
  { n: 8, name: 'Дозатор моющих средств', desc: 'Бункер и лоток часто меняются в сборе.', icon: '<rect width="16" height="8" x="4" y="8" rx="2"/><path d="M8 12h8"/>', x: 14, y: 28, ax: 38, ay: 22, products: [
    { name: 'Дозатор в сборе СМА Bosch', art: 'DSB-BS-11', price: '1 950 ₽' },
    { name: 'Лоток дозатора СМА LG', art: 'DSB-LG-04', price: '780 ₽' },
  ] },
  { n: 9, name: 'Шкив барабана', desc: 'Диаметр и посадка под вал — по шильдику бака.', icon: '<circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16" stroke-dasharray="3 3"/><circle cx="12" cy="12" r="2"/>', x: 12, y: 72, ax: 40, ay: 76, products: [
    { name: 'Шкив барабана СМА универсальный 280мм', art: 'PLV-280-U', price: '890 ₽' },
    { name: 'Шкив СМА Zanussi 250мм', art: 'PLV-ZN-250', price: '760 ₽' },
  ] },
  { n: 10, name: 'Подшипниковый узел', desc: 'Комплект: подшипники 6204/6205 + сальник.', icon: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>', x: 47, y: 95, ax: 50, ay: 90, products: [
    { name: 'Подшипниковый узел 6204+6205 + сальник', art: 'BRG-KIT-45', price: '1 240 ₽' },
