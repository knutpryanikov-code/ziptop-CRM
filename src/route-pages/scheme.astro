  { n: 11, name: 'Клапан подачи воды', desc: 'Соленоид 1/2/3 секции — по числу раздач.', icon: '<rect width="14" height="10" x="5" y="7" rx="2"/><path d="M5 10h14M9 4v3M15 4v3"/>', x: 14, y: 44, ax: 37, ay: 42, products: [
    { name: 'Клапан подачи 2-секц. универсал', art: 'VLV-2S-U', price: '950 ₽' },
    { name: 'Клапан подачи СМА Samsung 3-секц.', art: 'VLV-SM-3S', price: '1 300 ₽' },
  ] },
  { n: 12, name: 'Фильтр насоса', desc: 'Сливной фильтр — совпадение по резьбе улитки.', icon: '<circle cx="12" cy="12" r="6"/><path d="M12 6v12M6 12h12M8 8l8 8M16 8l-8 8" stroke-dasharray="2 2"/>', x: 14, y: 58, ax: 37, ay: 58, products: [
    { name: 'Фильтр сливного насоса Askoll', art: 'FLT-ASK-01', price: '320 ₽' },
    { name: 'Фильтр насоса СМА LG', art: 'FLT-LG-03', price: '290 ₽' },
  ] },
];

interface ModelSection { id: string; label: string; count: string; icon: string; models: { m: string; b: string }[] }

const SECTIONS: ModelSection[] = [
  { id: 'washer', label: 'Стиральная машина', count: '1 969', icon: '<rect width="18" height="18" x="3" y="3" rx="3"/><circle cx="12" cy="13" r="5"/><circle cx="12" cy="13" r="2"/><path d="M7 6.5h.01M10 6.5h.01"/>', models: [
    { m: 'WLG20060', b: 'Bosch' }, { m: 'WLG20260', b: 'Bosch' }, { m: 'WLG24260', b: 'Bosch' }, { m: 'WAN20060', b: 'Bosch' },
    { m: 'WF60F1R2E2WD', b: 'Samsung' }, { m: 'WW70J52E0HW', b: 'Samsung' }, { m: 'WW65K42E00W', b: 'Samsung' },
    { m: 'WISL 102', b: 'Indesit' }, { m: 'IWSD 5105', b: 'Indesit' }, { m: 'BWSA 51051', b: 'Indesit' },
    { m: 'F2J3NS0W', b: 'LG' }, { m: 'F80B8LD', b: 'LG' }, { m: 'FH0B8ND6', b: 'LG' },
    { m: '60С102', b: 'Atlant' }, { m: '70С108', b: 'Atlant' },
    { m: 'WRS 55P2 BSW', b: 'Beko' }, { m: 'WKB 61031', b: 'Beko' },
    { m: 'EWF 1074', b: 'Electrolux' }, { m: 'EWS 1066', b: 'Electrolux' },
    { m: 'CS4 1051D1', b: 'Candy' }, { m: 'GVS34 126TC2', b: 'Candy' },
    { m: 'ZWS 6127', b: 'Zanussi' }, { m: 'FWSD 61253', b: 'Whirlpool' }, { m: 'СМА-60С87', b: 'Дарина' },
  ] },
  { id: 'fridge', label: 'Холодильник', count: '46', icon: '<rect width="14" height="18" x="5" y="3" rx="2"/><path d="M5 10h14M9 6v2M9 13v3"/>', models: [
    { m: 'ХМ-6025', b: 'Atlant' }, { m: 'ХМ-4208', b: 'Atlant' }, { m: 'KGN36VL21', b: 'Bosch' }, { m: 'KGV33NW1', b: 'Bosch' },
    { m: 'RB33J3200SA', b: 'Samsung' }, { m: 'RB30J3000WW', b: 'Samsung' }, { m: 'GA-B419SEJL', b: 'LG' },
    { m: 'B18S50', b: 'Biryusa' }, { m: 'DF 4200', b: 'Liebherr' }, { m: 'RNB2535', b: 'Gorenje' },
    { m: 'B1RCNA364', b: 'Beko' }, { m: 'ERT 1502', b: 'Electrolux' }, { m: 'HD340WEN', b: 'Haier' }, { m: 'PC178', b: 'Indesit' },
  ] },
  { id: 'dishwasher', label: 'Посудомоечная машина', count: '905', icon: '<rect width="18" height="16" x="3" y="4" rx="2"/><path d="M3 9h18M7 14h.01M10 14h.01M13 14h.01M16 14h.01"/>', models: [
    { m: 'SMS24AW01R', b: 'Bosch' }, { m: 'SPS25CW03', b: 'Bosch' }, { m: 'ESF 2400', b: 'Electrolux' },
    { m: 'DFG 15B10', b: 'Beko' }, { m: 'DWF-400', b: 'Daewoo' }, { m: 'GS 63310', b: 'Gorenje' },
    { m: 'CDP 1L949', b: 'Candy' }, { m: 'HDW15V3', b: 'Haier' }, { m: 'MFD60S100', b: 'Midea' },
    { m: 'SF 64T354', b: 'Smeg' }, { m: 'ADP 402', b: 'Whirlpool' }, { m: 'ZDM 91501', b: 'Zanussi' },
  ] },
  { id: 'freezer', label: 'Морозильник', count: '282', icon: '<rect width="16" height="18" x="4" y="3" rx="2"/><path d="M12 6v8M8 8l8 4M16 8l-8 4" /><circle cx="12" cy="10" r="0.5"/>', models: [
    { m: 'М-7204', b: 'Atlant' }, { m: 'GSN33VB3', b: 'Bosch' }, { m: 'RZ20FAR', b: 'Samsung' },
    { m: 'F6152', b: 'Gorenje' }, { m: '106', b: 'Biryusa' }, { m: 'RF-67W00', b: 'Beko' },
    { m: 'LUF 17W', b: 'Electrolux' }, { m: 'BD-168', b: 'Haier' },
  ] },
  { id: 'dryer', label: 'Сушильная машина', count: '60', icon: '<rect width="18" height="18" x="3" y="3" rx="3"/><circle cx="12" cy="13" r="5"/><path d="M9 13c1-1.5 2-1.5 3 0s2 1.5 3 0"/>', models: [
