---
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = ['OZON', 'Wildberries', 'Яндекс Маркет'];
const specs = [
  ['Тип', 'Патрубок стиральной машины'],
  ['Бренд совместимости', 'Bosch'],
  ['Артикул', 'KG0020787'],
  ['Гарантия', '1 год'],
  ['Производитель', 'BOSCH; SIEMENS; NEFF; GAGGENAU'],
  ['Бренд', 'BOSCH; SIEMENS'],
  ['Длина упаковки', '200 мм'],
  ['Ширина упаковки', '150 мм'],
];
const keywords = ['Патрубок', 'стиральной', 'машины', 'Bosch', 'сливной', 'KG0020787', 'Запчасть', 'OZON'];
---

<BaseLayout title="Автокарточки для маркетплейсов — ЗИПТОП" active="crm">
  <main class="mx-auto max-w-[1440px] px-4 py-12 sm:px-6 lg:py-16">
    <p class="text-xs font-bold uppercase tracking-[0.24em] text-orange-600">ЗИПТОП · Интеграции</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">Автокарточки для маркетплейсов</h1>
    <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-500 sm:text-base">Выберите товар из каталога — платформа подготовит название, описание, характеристики и цену по правилам OZON, Wildberries и Яндекс Маркета.</p>

    <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6" aria-label="Генератор карточек">
      <div class="flex flex-wrap items-center gap-3">
        <label class="relative block min-w-[260px] flex-1" for="marketplace-search"><span class="sr-only">Найти товар в каталоге</span><svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m20 20-4.35-4.35"/></svg><input id="marketplace-search" class="h-11 w-full rounded-full bg-slate-100 pl-11 pr-4 text-sm text-slate-900 outline-none ring-orange-200 transition focus:ring-4" placeholder="Найти товар в каталоге…" /></label>
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Маркетплейс">{channels.map((channel, index) => <button type="button" class={`marketplace-tab rounded-full px-5 py-2.5 text-sm font-semibold transition ${index === 0 ? 'bg-blue-600 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`} data-channel={channel} role="tab" aria-selected={index === 0 ? 'true' : 'false'}>{channel}</button>)}</div>
        <button type="button" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-slate-200 px-4 text-sm font-semibold text-slate-700 transition hover:border-orange-300 hover:text-orange-700"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 11a8.1 8.1 0 0 0-15.5-3M4 4v4h4"/><path d="M4 13a8.1 8.1 0 0 0 15.5 3M20 20v-4h-4"/></svg>Другой вариант</button>
      </div>

      <p class="mt-5 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800"><strong>Предпросмотр шаблона.</strong> Публикация и синхронизация с кабинетами будут подключены отдельной задачей.</p>

      <div class="mt-6 grid gap-6 xl:grid-cols-[320px_minmax(0,1fr)]">
        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
          <div class="grid aspect-square place-items-center bg-gradient-to-br from-slate-50 to-slate-100 p-8"><svg class="h-36 w-36 text-slate-800" viewBox="0 0 160 160" fill="none" aria-hidden="true"><path d="M97 17c-12 0-25 8-28 20l-8 28 18 5 7-24c2-6 8-10 14-10 11 0 19 9 19 20 0 10-8 18-18 18h-17v18h17c20 0 37-16 37-36 0-22-18-39-41-39Z" fill="currentColor" opacity=".9"/><path d="m47 58 31 9-10 35-31-9z" fill="#f97316"/><path d="M32 102c-8 0-14 6-14 14s6 14 14 14h35v-28H32Z" fill="currentColor" opacity=".9"/><path d="M63 100h19v30H63z" fill="#f97316"/></svg></div>
          <div class="p-5"><h2 class="font-bold leading-5 text-slate-950">Патрубок стиральной машины Bosch сливной KG0020787</h2><p class="mt-2 text-sm text-slate-400">Арт. KG0020787 · Патрубки для стиральной машины</p><dl class="mt-6 space-y-2 border-t border-slate-100 pt-4 text-sm"><div class="flex justify-between gap-4"><dt class="text-slate-500">Цена сайта</dt><dd class="font-bold text-slate-900">1 500 ₽</dd></div><div class="flex justify-between gap-4"><dt class="text-slate-500">Цена маркетплейса (+15%)</dt><dd class="font-bold text-orange-600">1 720 ₽</dd></div></dl></div>
        </article>

        <div class="space-y-4">
          <article class="rounded-2xl border border-slate-200 p-5"><div class="flex items-center justify-between gap-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Название · до 60 символов</p><button class="copy-field text-xs font-semibold text-slate-500 hover:text-orange-600" data-copy="Патрубок стиральной машины Bosch сливной KG0020787">Копировать</button></div><p class="mt-3 font-semibold text-slate-900">Патрубок стиральной машины Bosch сливной KG0020787 для Bosch</p></article>
          <article class="rounded-2xl border border-slate-200 p-5"><div class="flex items-center justify-between gap-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Описание</p><button class="copy-field text-xs font-semibold text-slate-500 hover:text-orange-600" data-copy="Патрубок стиральной машины Bosch сливной KG0020787 — оригинальная запчасть из каталога ЗИПТОП. Категория: Патрубок стиральной машины. Совместимость: Bosch.">Копировать</button></div><p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-600">Патрубок стиральной машины Bosch сливной KG0020787 — оригинальная запчасть из каталога ЗИПТОП.
Категория: Патрубок стиральной машины. Совместимость: Bosch.
Коды замены и аналоги: UN1105177 · 105177 · RBH108B0.</p></article>
          <div class="grid gap-4 lg:grid-cols-2"><article class="rounded-2xl border border-slate-200 p-5"><div class="flex items-center justify-between gap-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Характеристики</p><button class="copy-field text-xs font-semibold text-slate-500 hover:text-orange-600" data-copy="Характеристики товара">Копировать</button></div><dl class="mt-3 divide-y divide-slate-100">{specs.map(([label, value]) => <div class="flex justify-between gap-4 py-2 text-sm"><dt class="text-slate-400">{label}</dt><dd class="max-w-[62%] text-right font-medium text-slate-700">{value}</dd></div>)}</dl></article><article class="rounded-2xl border border-slate-200 p-5"><div class="flex items-center justify-between gap-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Ключевые слова</p><button class="copy-field text-xs font-semibold text-slate-500 hover:text-orange-600" data-copy={keywords.join(', ')}>Копировать</button></div><div class="mt-4 flex flex-wrap gap-2">{keywords.map((keyword) => <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">{keyword}</span>)}</div></article></div>
          <div class="flex flex-wrap gap-3"><button class="copy-field inline-flex min-h-11 items-center rounded-full bg-slate-950 px-5 text-sm font-bold text-white transition hover:bg-slate-800" data-copy="Карточка подготовлена для публикации">Копировать всё</button><button type="button" class="inline-flex min-h-11 items-center rounded-full bg-orange-500 px-5 text-sm font-bold text-white transition hover:bg-orange-600">В очередь публикации</button></div>
          <article class="overflow-hidden rounded-2xl border border-slate-200"><div class="border-b border-slate-200 px-5 py-4"><h2 class="font-bold text-slate-950">Очередь публикации</h2></div><div class="flex items-center justify-between gap-4 px-5 py-4 text-sm"><span class="rounded-full bg-blue-600 px-2.5 py-1 text-xs font-bold text-white">OZON</span><span class="flex-1 font-medium text-slate-800">ТЭН 1900W с датчиком CMA SAMSUNG</span><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Опубликовано</span></div></article>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.marketplace-tab').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll<HTMLButtonElement>('.marketplace-tab').forEach((tab) => { const active = tab === button; tab.classList.toggle('bg-blue-600', active); tab.classList.toggle('text-white', active); tab.classList.toggle('bg-slate-100', !active); tab.classList.toggle('text-slate-600', !active); tab.setAttribute('aria-selected', String(active)); }); }));
    document.querySelectorAll<HTMLButtonElement>('.copy-field').forEach((button) => button.addEventListener('click', async () => { try { await navigator.clipboard.writeText(button.dataset.copy || ''); const text = button.textContent; button.textContent = 'Скопировано'; window.setTimeout(() => { button.textContent = text; }, 1200); } catch {} }));
  </script>
</BaseLayout>
