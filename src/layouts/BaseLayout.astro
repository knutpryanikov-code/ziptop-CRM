---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CitySelector from '../components/CitySelector.astro';
import MainHeaderSearch from '../components/MainHeaderSearch.astro';
import MainLoginPopup from '../components/MainLoginPopup.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = 'ЗИПТОП — экосистема запчастей и ремонта бытовой техники: каталог, взрыв-схемы, AI-подбор, CRM и вызов мастера в Новосибирске',
  active = '',
} = Astro.props;

const MENU = [
  { id: 'home', label: 'Главная', href: '/' },
  { id: 'catalog', label: 'Каталог', href: '/каталог/' },
  { id: 'scheme', label: 'Взрыв-схемы', href: '/взрыв-схемы/' },
  { id: 'ai', label: 'AI-подбор', href: '/ии-подбор/' },
  { id: 'ecosystem', label: 'Экосистема', href: '/экосистема/' },
  { id: 'contacts', label: 'Контакты', href: '/контакты/' },
];
const CATALOG_LINKS = [
  { label: 'Стиральные машины', href: '/каталог/?категория=Стиральные%20машины' },
  { label: 'Холодильники', href: '/каталог/?категория=Холодильники' },
  { label: 'Посудомоечные машины', href: '/каталог/?категория=Посудомоечные%20машины' },
  { label: 'Плиты и духовые шкафы', href: '/каталог/?категория=Плиты%20и%20духовые%20шкафы' },
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f97316" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      .main-site-header__inner { gap: 18px; }
      .main-site-brand__copy { display:grid; width:70px; line-height:1; color:#0f172a; font-size:18px; font-weight:800; letter-spacing:-.045em; }
      .main-site-brand__copy > span > span { color:#f97316; }
      /* Keep storage-dependent header controls out of the static first
         paint. CitySelector fills the saved value, then reveals both. */
      .main-site-header .main-header-search-wrap,
      .main-site-header .site-city-selector { visibility:hidden; opacity:0; transform:translateY(-2px); transition:opacity .18s ease-out,transform .18s ease-out; }
      .main-site-header.is-header-ready .main-header-search-wrap,
      .main-site-header.is-header-ready .site-city-selector { visibility:visible; opacity:1; transform:translateY(0); }
      .main-site-nav a[hidden] { display:none; }
      .main-site-nav { display:flex; flex:0 1 auto; min-width:0; }
      @media (max-width:1180px) { .main-site-header__inner { height:auto!important; min-height:64px; flex-wrap:wrap; gap:8px 14px; padding:8px 0; } }
      @media (max-width:640px) { .site-city-selector span { display:none; } }
    </style>
  </head>
  <body class="bg-[#f7f8fa] text-slate-900 antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="animate-blob absolute -top-48 left-1/2 h-[30rem] w-[46rem] -translate-x-1/2 rounded-full bg-orange-400/15 blur-3xl"></div>
      <div class="animate-blob animation-delay-2000 absolute -right-40 top-1/3 h-[24rem] w-[24rem] rounded-full bg-amber-300/10 blur-3xl"></div>
      <div class="animate-blob animation-delay-4000 absolute -left-40 top-2/3 h-[20rem] w-[20rem] rounded-full bg-orange-300/10 blur-3xl"></div>
    </div>

    <header class="main-site-header sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="main-site-header__inner mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
        <a href="/" class="main-site-brand flex shrink-0 items-center gap-2.5" aria-label="ЗИПТОП — на главную">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-orange-500 shadow-[0_0_18px_rgba(249,115,22,0.45)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </span>
          <span class="main-site-brand__copy"><span>ЗИП<span>ТОП</span></span></span>
        </a>
        <nav class="main-site-nav items-center gap-1 whitespace-nowrap text-[13px] font-medium text-slate-600" aria-label="Основная навигация">
          {MENU.map((item) => (
            item.id === active
              ? <span class="rounded-full bg-slate-900 px-3.5 py-1.5 text-white" aria-current="page">{item.label}</span>
              : <a class="rounded-full px-2.5 py-2 transition hover:text-orange-600" href={item.href} data-menu-optional={['scheme', 'ai', 'ecosystem', 'contacts'].includes(item.id) ? '' : undefined} data-astro-prefetch={item.id === 'catalog' ? 'load' : undefined} data-astro-reload={item.id === 'catalog' ? 'true' : undefined}>{item.label}</a>
          ))}
        </nav>
        <MainHeaderSearch />
        <div class="main-site-header__controls ml-auto flex shrink-0 items-center gap-3">
          <CitySelector />
          <MainLoginPopup />
          <button type="button" data-cart-toggle class="relative flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-white shadow-lg shadow-slate-900/20 transition hover:bg-orange-500 hover:shadow-orange-500/30" aria-label="Корзина">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            <span data-cart-count class="absolute -right-1 -top-1 grid min-h-5 min-w-5 place-items-center rounded-full bg-orange-500 px-1 text-[10px] font-extrabold text-white">0</span>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-16 bg-slate-950 text-slate-300">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
        <div>
          <a href="/" class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-orange-500 shadow-[0_0_18px_rgba(249,115,22,0.45)]">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
            <span class="text-lg font-extrabold tracking-tight text-white">ЗИП<span class="text-orange-500">ТОП</span></span>
          </a>
          <p class="mt-4 text-sm leading-6 text-slate-400">Цифровая экосистема запчастей и ремонта бытовой техники. Каталог поставщика «ДОКТОР ХАУС» — 101 861 позиция в наличии и под заказ.</p>
        </div>
        <nav aria-label="Каталог">
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Каталог</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {CATALOG_LINKS.map((item) => <li><a class="transition hover:text-orange-400" href={item.href}>{item.label}</a></li>)}
            <li><a class="transition hover:text-orange-400" href="/каталог/">Все категории</a></li>
          </ul>
        </nav>
        <nav aria-label="Экосистема">
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Экосистема</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a class="transition hover:text-orange-400" href="/экосистема/">Обзор экосистемы</a></li>
            <li><a class="transition hover:text-orange-400" href="/crm/">CRM и учёт</a></li>
            <li><a class="transition hover:text-orange-400" href="/взрыв-схемы/">Взрыв-схемы</a></li>
            <li><a class="transition hover:text-orange-400" href="/ии-подбор/">AI-подбор по фото</a></li>
            <li><a class="transition hover:text-orange-400" href="/партнёрам/">Партнёрам</a></li>
            <li><a class="transition hover:text-orange-400" href="/вызов-мастера/">Вызов мастера</a></li>
          </ul>
        </nav>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Контакты</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>г. Новосибирск, ул. Фрунзе, 63</li>
            <li><a class="flex items-center gap-2 transition hover:text-orange-400" href="tel:+79537777089"><svg class="h-4 w-4 shrink-0 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+7 953 777-70-89</a></li>
            <li><a class="flex items-center gap-2 transition hover:text-orange-400" href="mailto:admin@zipinsk.ru"><svg class="h-4 w-4 shrink-0 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>admin@zipinsk.ru</a></li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Пн–Пт: 10:00–19:00, Сб–Вс: 11:00–17:00</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-xs text-slate-500 sm:px-6">
          <p>© 2025 ООО «ЗИПТОП.РФ». ИНН 5408130126. Все права защищены.</p>
          <p>Оригинальные запчасти и сертифицированные аналоги · Гарантия до 1 года</p>
        </div>
      </div>
    </footer>

    <script>
      const initializedHeaderMenus = new WeakSet<HTMLElement>();
      const initResponsiveHeaderMenu = () => {
        const header = document.querySelector<HTMLElement>('.main-site-header');
        const nav = header?.querySelector<HTMLElement>('.main-site-nav');
        const search = header?.querySelector<HTMLElement>('.main-header-search-wrap');
        if (!header || !nav || !search || initializedHeaderMenus.has(header)) return;
        initializedHeaderMenus.add(header);
        const optional = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-menu-optional]'));
        const fitMenu = () => {
          optional.forEach((link) => { link.hidden = false; });
          const controls = header.querySelector<HTMLElement>('.main-site-header__controls');
          const rightLimit = window.matchMedia('(min-width: 1181px)').matches
            ? search.getBoundingClientRect().left - 14
            : (controls?.getBoundingClientRect().left || header.getBoundingClientRect().right) - 12;
          for (const link of [...optional].reverse()) {
            const visible = Array.from(nav.children).filter((item) => !(item as HTMLElement).hidden);
            if (!visible.length || (visible.at(-1) as HTMLElement).getBoundingClientRect().right <= rightLimit) break;
            link.hidden = true;
          }
        };
        const observer = new ResizeObserver(() => requestAnimationFrame(fitMenu));
        observer.observe(header); observer.observe(search);
        window.addEventListener('resize', fitMenu, { passive: true });
        window.addEventListener('ziptop:city-changed', () => requestAnimationFrame(fitMenu));
        document.fonts?.ready.then(fitMenu);
        requestAnimationFrame(fitMenu);
      };
      initResponsiveHeaderMenu();
      document.addEventListener('astro:page-load', initResponsiveHeaderMenu);
      // The logo already points to the current document on the home page.
      // Avoid a needless ClientRouter swap, which otherwise replaces the
      // header with its SSG markup for a moment.
      document.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const logo = (event.target as HTMLElement).closest<HTMLAnchorElement>('a.main-site-brand');
        if (!logo || new URL(logo.href).pathname !== window.location.pathname) return;
        event.preventDefault();
        event.stopImmediatePropagation();
      }, true);
      type LocationCache = { city: string; countryCode: string; expiresAt: number };
      const locationCacheKey = 'ziptop-location-v1';
      const fallback = 'Работаем по всей России';
      const defaultCity = 'Новосибирск';
      const updateLocationText = (city = '', countryCode = '') => {
        const normalized = city.trim();
        const isRussia = countryCode.toUpperCase() === 'RU' && normalized.length > 0;
        const headerText = `${isRussia ? normalized : defaultCity}`;
        document.querySelectorAll<HTMLElement>('[data-city-label]').forEach((element) => { element.lastChild!.textContent = headerText; });
        const names = isRussia ? [normalized] : [];
        for (const serviceCity of ['Новосибирск', 'Омск']) {
          if (!names.some((name) => name.localeCompare(serviceCity, 'ru', { sensitivity: 'base' }) === 0)) names.push(serviceCity);
        }
        const coverage = isRussia ? `Работаем в ${names.join(', ')} и по всей России.` : `${fallback}.`;
        document.querySelectorAll<HTMLElement>('[data-service-coverage]').forEach((element) => { element.textContent = coverage; });
      };
      try {
        const cached = JSON.parse(localStorage.getItem(locationCacheKey) || 'null') as LocationCache | null;
        if (cached && cached.expiresAt > Date.now()) {
          updateLocationText(cached.city, cached.countryCode);
        } else {
          fetch('https://ipwho.is/?lang=ru', { signal: AbortSignal.timeout(4_000) })
            .then((response) => response.ok ? response.json() : Promise.reject(new Error('Location lookup failed')))
            .then((data: { success?: boolean; city?: string; country_code?: string }) => {
              const city = data.success && data.country_code === 'RU' ? String(data.city || '').trim() : '';
              const countryCode = city ? 'RU' : '';
              localStorage.setItem(locationCacheKey, JSON.stringify({ city, countryCode, expiresAt: Date.now() + 7 * 24 * 60 * 60 * 1_000 }));
              updateLocationText(city, countryCode);
            })
            .catch(() => updateLocationText());
        }
      } catch {
        updateLocationText();
      }

      const updateCartCount = () => {
        try {
          const cart = JSON.parse(localStorage.getItem('ziptop_cart') || '[]');
          const count = Array.isArray(cart) ? cart.reduce((sum, item) => sum + (Number(item.quantity) || 0), 0) : 0;
          document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((node) => { node.textContent = String(count); });
        } catch {}
      };
      updateCartCount();
      window.addEventListener('cart:updated', updateCartCount);
      window.addEventListener('storage', (event) => { if (event.key === 'ziptop_cart') updateCartCount(); });
      document.addEventListener('click', async (event) => {
        const toggle = (event.target as HTMLElement).closest<HTMLElement>('[data-cart-toggle]');
        if (!toggle) return;
        event.preventDefault();
        const { openCart } = await import('../scripts/lazy-cart');
        openCart();
      });

      // The catalogue is deployed by its own Astro build. It should be
      // prefetched, but entered by a real navigation so its page scripts get
      // a clean document and initialize city/search state reliably.
      document.querySelectorAll<HTMLAnchorElement>('a[href^="/каталог/"]').forEach((link) => link.dataset.astroReload = 'true');
    </script>
  </body>
</html>
