---
import BaseLayout from '../../layouts/BaseLayout.astro';
const tabs = ['Обзор','Партнёры','Заказы и ремонты','Тарифы','Интеграции','Журнал'];
---
<BaseLayout title="Панель управления — ЗИПТОП · Демо">
<main id="admin-demo">
  <aside class="notice"><strong>Демонстрационные данные</strong><span>Все записи вымышлены. Изменения действуют до перезагрузки страницы. Сервер не подключён.</span></aside>
  <div class="heading"><div><p class="eyebrow">ЗИПТОП / УПРАВЛЕНИЕ</p><h1>Платформа под контролем</h1><p>Партнёры, заказы и условия работы в одном месте.</p></div><button data-reset>Сбросить демо</button></div>
  <div class="shell"><nav aria-label="Разделы панели">{tabs.map((name,i)=><button data-tab={i} aria-current={i===0?'page':undefined}>{name}<span>0{i+1}</span></button>)}<p>Режим: создатель · демо.<br/>Это не авторизация и не выдача прав.</p></nav>
  <div class="content">
    <section data-panel="0"><h2>Обзор платформы</h2><p>Показатели рассчитаны по демонстрационным записям.</p><div class="metrics" data-metrics></div><article class="card"><h3>Требуют внимания</h3><p data-attention></p><button data-tab="1">Открыть партнёров →</button></article></section>
    <section data-panel="1" hidden><div class="heading"><h2>Партнёры и роли</h2><button class="primary" data-add>Добавить партнёра</button></div><p>Мастер и продавец могут работать в одном аккаунте.</p><div class="filters"><label>Поиск<input data-search type="search" placeholder="Имя или email"/></label><label>Статус<select data-filter><option>Все</option><option>Активен</option><option>На проверке</option><option>Заблокирован</option></select></label></div><div class="table"><table><caption>Демонстрационные партнёры</caption><thead><tr><th>Партнёр</th><th>Роли</th><th>Статус</th><th>Скидка</th><th>Действие</th></tr></thead><tbody data-partners></tbody></table></div><p data-empty hidden>Партнёры не найдены.</p></section>
    <section data-panel="2" hidden><h2>Заказы и ремонты</h2><p>Статус меняется только в демонстрационной записи.</p><div class="table"><table><caption>Демо-заказы</caption><thead><tr><th>Заказ</th><th>Тип</th><th>Сумма</th><th>Статус</th></tr></thead><tbody data-orders></tbody></table></div></section>
    <section data-panel="3" hidden><h2>Тарифы и комиссии</h2><p>Фиксированная подписка + комиссия со сделки. Списаний нет.</p><form data-rates class="card"><div class="filters"><label>Товары, %<input name="sale" type="number" min="0" max="100" step="0.1" value="15" required/></label><label>Ремонт и услуги, %<input name="repair" type="number" min="0" max="100" step="0.1" value="30" required/></label></div><button class="primary">Применить в демо</button></form><div class="table"><table><caption>Подписки · стоимость за месяц</caption><thead><tr><th>Продукт</th><th>Цена</th></tr></thead><tbody>{[['Каталог запчастей','2 990 ₽'],['Заявки на ремонт','4 990 ₽'],['CRM мастера','3 990 ₽'],['CRM продавца','5 990 ₽'],['AI-диагностика (API)','9 990 ₽'],['BI-аналитика','14 990 ₽'],['AR-визуализация','7 990 ₽']].map(([a,b])=><tr><td>{a}</td><td>{b}</td></tr>)}</tbody></table></div></section>
    <section data-panel="4" hidden><h2>Интеграции</h2><p>Структура подключений. Состояние реальных сервисов здесь не проверяется.</p><div class="metrics">{[['МойСклад','Товары, цены, остатки и резерв'],['СДЭК / ПЭК','Стоимость и сроки доставки'],['ЮKassa','Платежи и возвраты'],['Avito / Ozon / WB / Яндекс Маркет','Карточки товаров и остатки'],['Telegram / MAX / WhatsApp','Уведомления клиентам'],['Yandex Cloud · авторизация','Учётные записи и проверка прав']].map(([name,description])=><article class="card"><small>Не подключено к демо</small><h3>{name}</h3><p>{description}</p></article>)}</div></section>
    <section data-panel="5" hidden><h2>Журнал изменений</h2><p>Действия только в текущей демо-сессии.</p><ol data-history></ol></section>
    <p role="status" aria-live="polite" data-message></p>
  </div></div>
  <dialog aria-labelledby="partner-title" data-editor><form data-partner-form><h2 id="partner-title">Партнёр · демо</h2><p>Используйте вымышленные данные.</p><input name="id" type="hidden"/><label>Наименование<input name="name" required maxlength="100"/></label><label>Email<input name="email" type="email" required maxlength="254"/></label><fieldset><legend>Роли</legend><label class="check"><input type="checkbox" name="seller"/>Продавец</label><label class="check"><input type="checkbox" name="master"/>Мастер / сервис-центр</label></fieldset><label>Статус<select name="status"><option>На проверке</option><option>Активен</option><option>Заблокирован</option></select></label><label>Скидка, %<input name="discount" type="number" min="0" max="100" value="0" required/></label><p data-error role="alert"></p><div class="actions"><button type="button" data-cancel>Отмена</button><button class="primary">Сохранить в демо</button></div></form></dialog>
  <noscript>Для работы демонстрации включите JavaScript.</noscript>
</main>
</BaseLayout>
<script>
type Partner={id:string;name:string;email:string;seller:boolean;master:boolean;status:string;discount:number};
const mounted=new WeakSet<HTMLElement>();
function init(){
 const root=document.getElementById('admin-demo');if(!root||mounted.has(root))return;mounted.add(root);
 const get=<T extends HTMLElement>(s:string)=>root.querySelector<T>(s)!;
 const seed:Partner[]=[{id:'1',name:'Демо · Сервис Сибирь',email:'service@example.com',seller:true,master:true,status:'Активен',discount:10},{id:'2',name:'Демо · Деталь Урал',email:'parts@example.com',seller:true,master:false,status:'На проверке',discount:0},{id:'3',name:'Демо · Алексей Мастер',email:'master@example.com',seller:false,master:true,status:'Активен',discount:5}];
 let partners=structuredClone(seed),sale=15,repair=30;
 const orders=[{id:'ДЕМО-104',type:'Ремонт',amount:6500,status:'В работе'},{id:'ДЕМО-105',type:'Товар',amount:3200,status:'Новый'},{id:'ДЕМО-106',type:'Ремонт',amount:4800,status:'Завершён'}],initial=orders.map(o=>o.status),history:string[]=[];
 const money=(n:number)=>n.toLocaleString('ru-RU')+' ₽';
 function node(tag:string,text:string){const e=document.createElement(tag);e.textContent=text;return e;}
 function journal(){get('[data-history]').replaceChildren(...(history.length?history:['Изменений пока нет.']).map(t=>node('li',t)));}
 function log(t:string){history.unshift(new Date().toLocaleTimeString('ru-RU')+' — '+t);get('[data-message]').textContent=t+' · только демо';journal();}
 function render(){
  get('[data-metrics]').replaceChildren(...[['Активные партнёры',String(partners.filter(p=>p.status==='Активен').length)],['Ожидают проверки',String(partners.filter(p=>p.status==='На проверке').length)],['Сумма демо-заказов',money(orders.filter(o=>o.status!=='Отменён').reduce((n,o)=>n+o.amount,0))],['Комиссии: товары / ремонт',sale+'% / '+repair+'%']].map(([a,b])=>{const e=node('article','');e.className='card';e.append(node('p',a),node('strong',b));return e;}));
  get('[data-attention]').textContent=partners.filter(p=>p.status==='На проверке').length+' заявок партнёров и '+orders.filter(o=>o.status==='Новый').length+' новых заказов.';
  const q=get<HTMLInputElement>('[data-search]').value.toLowerCase(),filter=get<HTMLSelectElement>('[data-filter]').value;
  const visible=partners.filter(p=>(filter==='Все'||filter===p.status)&&(p.name+' '+p.email).toLowerCase().includes(q));
  get('[data-empty]').hidden=visible.length>0;
  get('[data-partners]').replaceChildren(...visible.map(p=>{const row=node('tr',''),identity=node('td',p.name),cell=node('td',''),button=node('button','Изменить');identity.append(node('small',p.email));button.setAttribute('aria-label','Изменить '+p.name);button.addEventListener('click',()=>edit(p));cell.append(button);row.append(identity,node('td',[p.seller?'Продавец':'',p.master?'Мастер':''].filter(Boolean).join(' + ')),node('td',p.status),node('td',p.discount+'%'),cell);return row;}));
  get('[data-orders]').replaceChildren(...orders.map(o=>{const row=node('tr',''),cell=node('td',''),select=document.createElement('select');select.setAttribute('aria-label','Статус '+o.id);['Новый','В работе','Завершён','Отменён'].forEach(s=>select.add(new Option(s,s,false,s===o.status)));select.addEventListener('change',()=>{o.status=select.value;log(o.id+': '+o.status);render();});cell.append(select);row.append(node('td',o.id),node('td',o.type),node('td',money(o.amount)),cell);return row;}));journal();
 }
 root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(b=>b.addEventListener('click',()=>{root.querySelectorAll<HTMLElement>('[data-panel]').forEach(p=>p.hidden=p.dataset.panel!==b.dataset.tab);root.querySelectorAll('nav [data-tab]').forEach(n=>{if((n as HTMLElement).dataset.tab===b.dataset.tab)n.setAttribute('aria-current','page');else n.removeAttribute('aria-current');});get('[data-message]').textContent='';}));
 const form=get<HTMLFormElement>('[data-partner-form]'),dialog=get<HTMLDialogElement>('[data-editor]');
 function edit(p?:Partner){form.reset();get('[data-error]').textContent='';for(const name of ['id','name','email','status','discount'] as const)(form.elements.namedItem(name) as HTMLInputElement).value=String(p?.[name]??(name==='discount'?0:name==='status'?'На проверке':''));for(const name of ['seller','master'] as const)(form.elements.namedItem(name) as HTMLInputElement).checked=p?.[name]||false;dialog.showModal();}
 get('[data-add]').addEventListener('click',()=>edit());get('[data-cancel]').addEventListener('click',()=>dialog.close());
 form.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form),id=String(d.get('id')),name=String(d.get('name')).trim(),email=String(d.get('email')).trim().toLowerCase();if(!name||(!d.has('seller')&&!d.has('master'))){get('[data-error]').textContent='Укажите имя и хотя бы одну роль.';return;}if(partners.some(p=>p.email===email&&p.id!==id)){get('[data-error]').textContent='Этот email уже есть в демо.';return;}const p:Partner={id:id||crypto.randomUUID(),name,email,seller:d.has('seller'),master:d.has('master'),status:String(d.get('status')),discount:Number(d.get('discount'))};const i=partners.findIndex(p=>p.id===id);if(i<0)partners.push(p);else partners[i]=p;dialog.close();log('Сохранён партнёр '+name);render();});
 get('[data-search]').addEventListener('input',render);get('[data-filter]').addEventListener('change',render);
 const rates=get<HTMLFormElement>('[data-rates]');rates.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(rates);sale=Number(d.get('sale'));repair=Number(d.get('repair'));log('Комиссии обновлены');render();});
 get('[data-reset]').addEventListener('click',()=>{partners=structuredClone(seed);sale=15;repair=30;orders.forEach((o,i)=>o.status=initial[i]);history.length=0;rates.reset();get<HTMLInputElement>('[data-search]').value='';get<HTMLSelectElement>('[data-filter]').value='Все';log('Демонстрация сброшена');render();});render();
}
init();document.addEventListener('astro:page-load',init);
</script>
<style>
#admin-demo{max-width:1280px;margin:auto;padding:28px 24px;color:#182234}.notice{display:flex;gap:16px;padding:16px 20px;border:1px solid #fed7aa;border-radius:12px;background:#fff7ed;color:#85400f;font-size:14px}.notice strong{white-space:nowrap}.heading{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:28px 0}.eyebrow{font-size:12px;letter-spacing:.16em;color:#c4510c;font-weight:700}h1{font-size:32px;font-weight:800;letter-spacing:-.03em}h2{font-size:24px;font-weight:750}h3{font-size:18px;font-weight:700;margin:12px 0}p{line-height:1.65;color:#64748b}.shell{display:grid;grid-template-columns:230px minmax(0,1fr);gap:28px}.shell nav{display:flex;flex-direction:column;gap:6px;align-self:start;padding:12px;border-radius:16px;background:#101c2d;color:#d1d9e5}.shell nav button{display:flex;justify-content:space-between;background:transparent;border:0;color:inherit;text-align:left}.shell nav button[aria-current]{background:#f97316;color:white}.shell nav span{opacity:.6}.shell nav p{font-size:12px;padding:18px 12px;color:#b3bfce}.content{min-width:0}button{padding:10px 14px;border:1px solid #cbd5e1;border-radius:9px;background:white;font-size:14px;font-weight:650;cursor:pointer}button:hover{filter:brightness(.96)}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #ea580c;outline-offset:3px}.primary{background:#ea580c;color:white;border-color:#ea580c}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:22px 0}.card{padding:22px;background:white;border:1px solid #e2e8f0;border-radius:14px}.card strong{display:block;font-size:28px;margin-top:10px}.card small{color:#64748b}.filters{display:flex;flex-wrap:wrap;gap:16px;margin:22px 0}.filters label{flex:1;min-width:150px}label{display:grid;gap:7px;font-size:14px;font-weight:600}input,select{width:100%;min-width:0;padding:10px 12px;border:1px solid #cbd5e1;border-radius:8px;background:white;color:#182234;font:inherit}.table{overflow:auto;max-width:100%;margin-top:22px;background:white;border:1px solid #e2e8f0;border-radius:12px}table{width:100%;border-collapse:collapse;font-size:14px;text-align:left}th,td{padding:15px;border-bottom:1px solid #e2e8f0}th{background:#f1f5f9;color:#475569}caption{padding:15px;text-align:left}td small{display:block;color:#64748b;margin-top:5px}td select{min-width:140px}[data-message]{min-height:30px;margin-top:20px;color:#166534}dialog{width:min(520px,calc(100% - 32px));max-height:90vh;overflow:auto;padding:28px;border:1px solid #e2e8f0;border-radius:18px}dialog::backdrop{background:#0f172a80}dialog label,fieldset{margin-top:16px}.check{display:flex;align-items:center;gap:8px}.check input{width:auto}.actions{display:flex;justify-content:flex-end;gap:12px;margin-top:20px}[data-error]{color:#b91c1c}[data-history] li{padding:15px;border-bottom:1px solid #e2e8f0;font-size:14px}section[hidden]{display:none}@media(max-width:900px){.shell{grid-template-columns:1fr}.shell nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.shell nav p{grid-column:1/-1}.heading,.notice{flex-direction:column;align-items:flex-start}}@media(max-width:520px){#admin-demo{padding:20px 12px}h1{font-size:26px}.metrics,.shell nav{grid-template-columns:1fr}}
</style>
