---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCatalog from '../components/HomeCatalog.astro';

const CATEGORIES = [
  { label: 'Стиральные машины', count: '212 позиций', icon: '<rect width="18" height="18" x="3" y="3" rx="3"/><circle cx="12" cy="13" r="5"/><circle cx="12" cy="13" r="2"/><path d="M7 6.5h.01M10 6.5h.01"/>' },
  { label: 'Холодильники', count: '49 позиций', icon: '<rect width="14" height="18" x="5" y="3" rx="2"/><path d="M5 10h14M9 6v2M9 13v3"/>' },
  { label: 'Посудомоечные машины', count: '50 позиций', icon: '<rect width="18" height="16" x="3" y="4" rx="2"/><path d="M3 9h18M7 14h.01M10 14h.01M13 14h.01M16 14h.01"/>' },
  { label: 'Плиты и духовые шкафы', count: '81 позиция', icon: '<rect width="18" height="14" x="3" y="5" rx="2"/><path d="M3 10h18M7 14h10"/><circle cx="7" cy="7.5" r="0.5"/><circle cx="10" cy="7.5" r="0.5"/>' },
  { label: 'Пылесосы', count: '23 позиции', icon: '<circle cx="10" cy="14" r="6"/><path d="M14 10l5-5M15 16h5a2 2 0 0 0 2-2v-1"/><circle cx="10" cy="14" r="2"/>' },
  { label: 'Микроволновые печи', count: '36 позиций', icon: '<rect width="18" height="12" x="3" y="6" rx="2"/><path d="M6 10h7M6 13h7"/><circle cx="17" cy="10" r="0.5"/><circle cx="17" cy="13" r="0.5"/>' },
  { label: 'Водонагреватели', count: '28 позиций', icon: '<rect width="12" height="18" x="6" y="3" rx="3"/><path d="M12 8v5M9.5 10.5h5"/>' },
  { label: 'Кофемашины', count: '17 позиций', icon: '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v6a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5z"/><path d="M7 2v2M11 2v2M15 2v2"/>' },
];

const BRANDS = ['BOSCH', 'SAMSUNG', 'LG', 'INDESIT', 'BEKO', 'ELECTROLUX', 'ATLANT', 'ZANUSSI', 'WHIRLPOOL', 'CANDY', 'GORENJE', 'SIEMENS', 'HAIER'];
---
<BaseLayout title="ЗИПТОП — каталог запчастей для бытовой техники | Новосибирск" active="home">
  <!-- Hero -->
  <section class="bg-slate-950 text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-20">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl" data-animate>
          Запчасти для бытовой техники с <span class="bg-gradient-to-r from-orange-500 to-amber-400 bg-clip-text text-transparent">доставкой день в день</span>
        </h1>
        <p class="mt-5 max-w-lg text-base leading-7 text-slate-400" data-animate>
          Оригинальные детали и сертифицированные аналоги от ведущих брендов. Найдите запчасть по артикулу, модели или взрыв-схеме — мастер приедет и установит её за 1 час.
        </p>
        <form id="hero-search" class="mt-8 flex max-w-xl items-center gap-3" data-animate role="search">
          <label class="flex flex-1 items-center gap-3 rounded-full bg-white/10 px-5 py-3.5 ring-1 ring-white/15 transition focus-within:ring-orange-500">
            <svg class="h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input id="hero-q" type="search" name="q" placeholder="Например: ТЭН Samsung, помпа, DC97-17235A…" class="w-full bg-transparent text-sm text-white placeholder:text-slate-500 focus:outline-none" aria-label="Поиск запчасти" />
          </label>
          <button type="submit" class="shrink-0 rounded-full bg-orange-500 px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-orange-500/30 transition hover:bg-orange-600">Найти запчасть</button>
        </form>
        <div class="mt-8 flex flex-wrap gap-6 text-sm" data-animate>
          <div><p class="text-xl font-extrabold text-orange-400" data-counter>101 861</p><p class="mt-0.5 text-xs text-slate-500">SKU в каталоге</p></div>
          <div><p class="text-xl font-extrabold text-orange-400" data-counter>42</p><p class="mt-0.5 text-xs text-slate-500">бренда</p></div>
          <div><p class="text-xl font-extrabold text-orange-400" data-counter>1 час</p><p class="mt-0.5 text-xs text-slate-500">выезд мастера</p></div>
        </div>
      </div>
      <div class="relative hidden lg:block" data-animate="card">
        <div class="relative mx-auto aspect-[4/5] max-h-[440px] w-full max-w-[360px]">
          <div class="absolute left-1/2 top-[8%] h-[84%] w-[42%] -translate-x-1/2 rounded-[14%] border-2 border-white/15 bg-white/5">
            <div class="absolute left-[6%] top-[3%] h-[10%] w-[88%] rounded-lg border border-white/10 bg-white/5"></div>
            <div class="absolute left-1/2 top-[26%] h-[44%] w-[76%] -translate-x-1/2 rounded-full border-[3px] border-white/20"></div>
            <div class="absolute left-1/2 top-[32%] h-[32%] w-[56%] -translate-x-1/2 rounded-full border-2 border-dashed border-orange-500/30"></div>
          </div>
          {[
            { n: 1, x: 88, y: 24 }, { n: 2, x: 90, y: 44 }, { n: 3, x: 84, y: 64 }, { n: 4, x: 74, y: 82 },
            { n: 5, x: 26, y: 82 }, { n: 6, x: 16, y: 64 }, { n: 7, x: 10, y: 44 }, { n: 8, x: 12, y: 24 },
          ].map((node) => (
            <a href="https://xn--g1acsdbq.xn--p1ai/scheme/" class="group absolute flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-white/10 text-slate-300 backdrop-blur transition-all duration-300 hover:scale-110 hover:border-orange-500 hover:bg-orange-500 hover:text-white" style={`left:${node.x}%;top:${node.y}%`} aria-label={`Узел схемы ${node.n}`}>
              <span class="text-xs font-bold">{node.n}</span>
              <span class="absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full bg-orange-500 transition group-hover:bg-white"></span>
            </a>
          ))}
          <a href="https://xn--g1acsdbq.xn--p1ai/scheme/" class="absolute bottom-0 right-0 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400 transition hover:text-orange-300">Открыть взрыв-схемы <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <!-- Бренды -->
    <div class="border-t border-white/10 py-5">
      <div class="overflow-hidden" aria-hidden="true">
        <div class="animate-marquee flex w-max items-center gap-10 pr-10">
          {[...BRANDS, ...BRANDS].map((b) => (
            <span class="whitespace-nowrap text-sm font-bold uppercase tracking-[0.2em] text-slate-600">{b}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Категории -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-orange-600" data-animate>Каталог</p>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950" data-animate>Категории запчастей</h2>
      </div>
      <a href="https://xn--g1acsdbq.xn--p1ai/scheme/" class="hidden items-center gap-1.5 text-sm font-semibold text-slate-500 transition hover:text-orange-600 sm:inline-flex" data-animate>Все схемы <span aria-hidden="true">→</span></a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {CATEGORIES.map((c) => (
        <a href="https://xn--g1acsdbq.xn--p1ai/scheme/" class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-orange-200 hover:shadow-xl hover:shadow-orange-500/10" data-animate="card">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-orange-500/10 text-orange-500 transition-transform duration-300 group-hover:rotate-6 group-hover:scale-110">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
          </span>
          <p class="mt-4 font-bold text-slate-950">{c.label}</p>
          <p class="mt-1 text-sm text-slate-400">{c.count}</p>
        </a>
      ))}
    </div>
  </section>

  <HomeCatalog />

  <!-- AI CTA -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6">
    <div class="grid gap-5 lg:grid-cols-2">
      <a href="https://xn--g1acsdbq.xn--p1ai/ai/" class="group rounded-3xl bg-slate-950 p-8 text-white transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-slate-900/30" data-animate="card">
        <svg class="h-8 w-8 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.7L19.5 10l-5.6 1.3L12 17l-1.9-5.7L4.5 10l5.6-1.3z"/><path d="M19 15l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z"/></svg>
        <h2 class="mt-4 text-xl font-bold">Не знаете артикул? Подбор по фото</h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">Сфотографируйте шильдик или код ошибки — AI определит модель и подберёт деталь с точностью до 98%.</p>
        <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-400 transition group-hover:gap-2.5">Попробовать AI <span aria-hidden="true">→</span></span>
      </a>
      <a href="https://xn--g1acsdbq.xn--p1ai/master/" class="group rounded-3xl border border-slate-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-orange-200 hover:shadow-xl hover:shadow-orange-500/10" data-animate="card">
        <svg class="h-8 w-8 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <h2 class="mt-4 text-xl font-bold text-slate-950">Мастер за 1 час</h2>
        <p class="mt-2 text-sm leading-6 text-slate-500">Не хотите ремонтировать сами? Приедем с запчастью, заменим и дадим гарантию до 1 года.</p>
        <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-600 transition group-hover:gap-2.5">Вызвать мастера <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <script>
    import { gsap } from 'gsap';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      gsap.from('[data-animate]:not([data-animate="card"])', { y: 26, autoAlpha: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out', clearProps: 'all' });
      gsap.from('[data-animate="card"]', { y: 32, autoAlpha: 0, duration: 0.6, stagger: 0.07, delay: 0.3, ease: 'power3.out', clearProps: 'all' });
      document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => {
        const finalText = el.textContent ?? '';
        const match = finalText.match(/[\d\s ]+/);
        if (!match) return;
        const target = parseInt(match[0].replace(/[^\d]/g, ''), 10);
        const suffix = finalText.slice(match[0].length).trim();
        if (Number.isNaN(target)) return;
        const counter = { v: 0 };
        gsap.to(counter, { v: target, duration: 1.4, delay: 0.6, ease: 'power2.out', onUpdate: () => { el.textContent = `${Math.round(counter.v).toLocaleString('ru-RU')}${suffix ? ` ${suffix}` : ''}`; } });
      });
    }

    const form = document.getElementById('hero-search');
    const qInput = document.getElementById('hero-q') as HTMLInputElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = qInput?.value.trim();
      location.href = query ? `https://xn--g1acsdbq.xn--p1ai/market/?q=${encodeURIComponent(query)}` : 'https://xn--g1acsdbq.xn--p1ai/market';
    });
  </script>
</BaseLayout>
