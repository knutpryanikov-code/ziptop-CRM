  <script id="crm-data" type="application/json" set:html={JSON.stringify(crmData)}></script>

  <script>
    import { gsap } from 'gsap';

    interface CrmOrder { id: string; date: string; client: string; item: string; channel: string; sum: string; stage: number }
    interface CrmRepair { id: string; client: string; device: string; problem: string; part: string; master: string; stage: number }
    interface CrmNotification { time: string; channel: string; text: string }
    interface CrmChannel { id: string; label: string; on: boolean }
    interface CrmData {
      flow: string[];
      stages: string[];
      orders: CrmOrder[];
      repairs: CrmRepair[];
      notifications: CrmNotification[];
      channels: CrmChannel[];
    }
    interface CrmState {
      tab: string;
      channels: Record<string, boolean>;
      orders: Record<string, number>;
      repairs: Record<string, number>;
    }

    const data: CrmData = JSON.parse(document.getElementById('crm-data')?.textContent ?? '{}');
    const STORAGE_KEY = 'ziptop-crm-v1';

    const defaults: CrmState = {
      tab: 'overview',
      channels: Object.fromEntries(data.channels.map((c) => [c.id, c.on])),
      orders: Object.fromEntries(data.orders.map((o) => [o.id, o.stage])),
      repairs: Object.fromEntries(data.repairs.map((r) => [r.id, r.stage])),
    };

    let state: CrmState = defaults;
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const saved: unknown = raw ? JSON.parse(raw) : null;
      if (saved && typeof saved === 'object') state = { ...defaults, ...(saved as Partial<CrmState>) };
    } catch { /* демо-режим без сохранения */ }

    const save = (): void => {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch { /* ignore */ }
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const orderBadge = [
      'bg-orange-100 text-orange-700',
      'bg-sky-100 text-sky-700',
      'bg-indigo-100 text-indigo-700',
      'bg-violet-100 text-violet-700',
      'bg-emerald-100 text-emerald-700',
    ];
    const stageColor = ['bg-slate-300', 'bg-amber-400', 'bg-orange-500', 'bg-sky-500', 'bg-emerald-500'];
    const stageBorder = ['border-slate-300', 'border-amber-400', 'border-orange-500', 'border-sky-500', 'border-emerald-500'];
    const stageTint = ['bg-gradient-to-br from-slate-50 to-white', 'bg-gradient-to-br from-amber-50 to-white', 'bg-gradient-to-br from-orange-50 to-white', 'bg-gradient-to-br from-sky-50 to-white', 'bg-gradient-to-br from-emerald-50 to-white'];
    const channelBadge: Record<string, string> = {
      Telegram: 'bg-sky-100 text-sky-700',
      WhatsApp: 'bg-emerald-100 text-emerald-700',
      MAX: 'bg-violet-100 text-violet-700',
    };

    const escMap: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    const esc = (s: string): string => s.replace(/[&<>"']/g, (ch) => escMap[ch] ?? ch);

    /* ---------- Вкладки ---------- */
    const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

    function setTab(id: string, updateHash = true, animate = true): void {
      state.tab = id;
      const tabBase = 'inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 active:scale-95';
      tabButtons.forEach((btn) => {
        const active = btn.dataset.tab === id;
        btn.setAttribute('aria-selected', String(active));
        btn.className = active ? `${tabBase} bg-slate-900 text-white shadow-lg shadow-slate-900/20` : `${tabBase} text-slate-600 hover:text-slate-900`;
      });
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
      const activePanel = panels.find((p) => p.dataset.panel === id);
      if (activePanel && animate && !reduceMotion) {
        gsap.fromTo(activePanel, { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power2.out', clearProps: 'all' });
      }
      if (updateHash) history.replaceState(null, '', `#${id}`);
      save();
    }

    tabButtons.forEach((btn, i) => {
      btn.addEventListener('click', () => setTab(btn.dataset.tab ?? 'overview'));
      btn.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabButtons[(i + (e.key === 'ArrowRight' ? 1 : tabButtons.length - 1)) % tabButtons.length];
        next.focus();
        setTab(next.dataset.tab ?? 'overview');
      });
    });
    document.querySelectorAll<HTMLElement>('[data-goto-tab]').forEach((el) =>
      el.addEventListener('click', () => setTab(el.dataset.gotoTab ?? 'overview'))
    );

    /* ---------- Каналы уведомлений ---------- */
    const togglesBox = document.getElementById('channel-toggles');
    function renderChannels(): void {
      if (!togglesBox) return;
      togglesBox.innerHTML = '';
      data.channels.forEach((ch) => {
        const on = state.channels[ch.id] ?? ch.on;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('aria-pressed', String(on));
        btn.className = `rounded-full px-4 py-1.5 text-sm font-semibold transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 active:scale-95 ${
          on ? 'bg-sky-100 text-sky-700 ring-1 ring-sky-300 hover:bg-sky-200' : 'bg-slate-100 text-slate-400 hover:bg-slate-200'
        }`;
        btn.textContent = `${ch.label} ${on ? 'вкл' : 'выкл'}`;
        btn.addEventListener('click', () => { state.channels[ch.id] = !on; save(); renderChannels(); renderFeed(); });
        togglesBox.appendChild(btn);
      });
    }

    /* ---------- Лента уведомлений ---------- */
    const feed = document.getElementById('notifications-feed');
    function renderFeed(): void {
      if (!feed) return;
      feed.innerHTML = data.notifications.map((n) => {
        const off = state.channels[n.channel.toLowerCase()] === false;
        const badge = channelBadge[n.channel] ?? 'bg-slate-100 text-slate-600';
        return `<li class="flex gap-4 border-b border-slate-100 pb-4 last:border-0 last:pb-0 ${off ? 'opacity-40' : ''}">
          <time class="w-10 shrink-0 pt-0.5 text-xs text-slate-400">${esc(n.time)}</time>
          <div>
            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold ${badge}">${esc(n.channel)}</span>
            <p class="mt-1.5 text-sm leading-6 text-slate-700">${esc(n.text)}</p>
          </div>
        </li>`;
      }).join('');
    }

    /* ---------- Кнопки смены статуса ---------- */
    function moveButton(id: string, kind: string, dir: number, disabled: boolean): string {
      return `<button type="button" data-kind="${kind}" data-id="${id}" data-dir="${dir}" ${disabled ? 'disabled' : ''}
        aria-label="${dir > 0 ? 'Следующий статус' : 'Предыдущий статус'}"
        class="rounded-full p-1.5 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 ${disabled ? 'cursor-not-allowed text-slate-200' : 'text-slate-500 hover:bg-slate-100 hover:text-orange-600'}">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="${dir > 0 ? 'm9 18 6-6-6-6' : 'm15 18-6-6 6-6'}"/></svg>
      </button>`;
    }

    /* ---------- Заказы ---------- */
    const ordersBody = document.getElementById('orders-table-body');
    function renderOrders(): void {
      if (!ordersBody) return;
      ordersBody.innerHTML = data.orders.map((o) => {
        const st = state.orders[o.id] ?? o.stage;
        return `<tr data-order-id="${o.id}" class="border-b border-slate-100 transition-colors last:border-0 hover:bg-orange-50/40">
          <td class="px-6 py-4"><p class="font-bold text-slate-900">${esc(o.id)}</p><p class="mt-0.5 text-xs text-slate-400">${esc(o.date)}</p></td>
          <td class="px-4 py-4 text-slate-700">${esc(o.client)}</td>
          <td class="max-w-[260px] truncate px-4 py-4 text-slate-600" title="${esc(o.item)}">${esc(o.item)}</td>
          <td class="px-4 py-4"><span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">${esc(o.channel)}</span></td>
          <td class="px-4 py-4 font-bold text-slate-900">${esc(o.sum)}</td>
          <td class="px-4 py-4"><span data-badge class="inline-block rounded-full px-3 py-1 text-xs font-semibold ${orderBadge[st]}">${esc(data.flow[st])}</span></td>
          <td class="whitespace-nowrap px-6 py-4">${moveButton(o.id, 'order', -1, st === 0)}${moveButton(o.id, 'order', 1, st === data.flow.length - 1)}</td>
        </tr>`;
      }).join('');
    }

    /* ---------- Канбан ремонтов ---------- */
    const board = document.getElementById('kanban-board');
    function repairCard(r: CrmRepair): string {
      const st = state.repairs[r.id] ?? r.stage;
      return `<article data-repair-id="${r.id}" class="rounded-2xl border border-slate-200 border-l-4 ${stageBorder[st]} ${stageTint[st]} p-4 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
        <p class="text-sm font-bold text-slate-900">${esc(r.id)} · ${esc(r.client)}</p>
        <p class="mt-0.5 text-xs font-medium text-slate-500">${esc(r.device)}</p>
        <p class="mt-2 text-xs leading-5 text-slate-500">${esc(r.problem)} · ${esc(r.part)}</p>
        <p class="mt-1 text-xs text-slate-400">Мастер: ${esc(r.master)}</p>
        <div class="mt-3 flex justify-between">
          ${moveButton(r.id, 'repair', -1, st === 0)}
          ${moveButton(r.id, 'repair', 1, st === data.stages.length - 1)}
        </div>
      </article>`;
    }
    function renderBoard(animate = false): void {
      if (!board) return;
      board.innerHTML = data.stages.map((stage, i) => {
        const items = data.repairs.filter((r) => (state.repairs[r.id] ?? r.stage) === i);
        return `<section class="rounded-3xl bg-slate-100/70 p-3" aria-label="${esc(stage)}">
          <header class="flex items-center justify-between px-2 pb-3 pt-1">
            <h3 class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500"><span class="h-2 w-2 rounded-full ${stageColor[i]}"></span>${esc(stage)}</h3>
            <span class="text-xs font-bold text-slate-400">${items.length}</span>
          </header>
          <div class="space-y-3">${items.map(repairCard).join('') || '<p class="px-2 pb-2 text-xs text-slate-400">Нет ремонтов</p>'}</div>
        </section>`;
      }).join('');
      if (animate && !reduceMotion) {
        gsap.from('#kanban-board article', { y: 16, autoAlpha: 0, scale: 0.96, duration: 0.35, stagger: 0.045, ease: 'back.out(1.6)', clearProps: 'all' });
      }
    }

    /* ---------- Ремонты в работе (обзор) + KPI ---------- */
    function renderActiveRepairs(): void {
      const active = data.repairs.filter((r) => (state.repairs[r.id] ?? r.stage) < data.stages.length - 1);
      const box = document.getElementById('repairs-active-list');
      if (box) {
        box.innerHTML = active.map((r) => {
          const st = state.repairs[r.id] ?? r.stage;
          return `<li class="rounded-2xl border border-slate-200 border-l-4 ${stageBorder[st]} ${stageTint[st]} p-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-bold text-slate-900">${esc(r.id)} · ${esc(r.device)}</p>
              <span class="shrink-0 text-xs font-medium text-slate-400">${esc(data.stages[st])}</span>
            </div>
            <p class="mt-1 text-xs text-slate-500">${esc(r.problem)} · запчасть: ${esc(r.part)} · мастер ${esc(r.master)}</p>
          </li>`;
        }).join('') || '<li class="text-sm text-slate-400">Все ремонты завершены</li>';
      }
      const kpi = document.getElementById('kpi-repairs');
      if (kpi) kpi.textContent = String(active.length);
    }

    /* ---------- Делегирование кликов по кнопкам смены статуса ---------- */
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest<HTMLButtonElement>('button[data-kind]');
      if (!btn || btn.disabled) return;
      const kind = btn.dataset.kind;
      const id = btn.dataset.id;
      const dir = Number(btn.dataset.dir);
      if (!kind || !id || Number.isNaN(dir)) return;
      if (kind === 'order') {
        state.orders[id] = Math.min(data.flow.length - 1, Math.max(0, (state.orders[id] ?? 0) + dir));
        save(); renderOrders();
        if (!reduceMotion) {
          const badge = document.querySelector(`tr[data-order-id="${id}"] [data-badge]`);
          if (badge) gsap.fromTo(badge, { scale: 0.7 }, { scale: 1, duration: 0.45, ease: 'back.out(3)', clearProps: 'all' });
        }
      } else {
        state.repairs[id] = Math.min(data.stages.length - 1, Math.max(0, (state.repairs[id] ?? 0) + dir));
        save(); renderBoard(true); renderActiveRepairs();
      }
    });

    /* ---------- Входные анимации и счётчики ---------- */
    function animateCounters(): void {
      document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => {
        const finalText = el.textContent ?? '';
        const match = finalText.match(/[\d\s ]+/);
        if (!match) return;
        const target = parseInt(match[0].replace(/[^\d]/g, ''), 10);
        const suffix = finalText.slice(match[0].length).trimStart();
        if (Number.isNaN(target)) return;
        const counter = { v: 0 };
        gsap.to(counter, {
          v: target,
          duration: 1.4,
          ease: 'power2.out',
          onUpdate: () => { el.textContent = `${Math.round(counter.v).toLocaleString('ru-RU')}${suffix ? ` ${suffix}` : ''}`; },
        });
      });
    }

    function entrance(): void {
      const ease = 'power3.out';
      gsap.from('header', { y: -32, autoAlpha: 0, duration: 0.5, ease, clearProps: 'all' });
      gsap.from('.crm-eyebrow, .crm-title', { y: 26, autoAlpha: 0, duration: 0.55, stagger: 0.1, delay: 0.2, ease, clearProps: 'all' });
      gsap.from('[role="tablist"]', { y: 16, autoAlpha: 0, duration: 0.45, delay: 0.4, ease, clearProps: 'all' });
      gsap.from('.crm-banner', { y: 16, autoAlpha: 0, duration: 0.45, delay: 0.55, ease, clearProps: 'all' });
      gsap.from('[data-animate="kpi"]', { y: 30, autoAlpha: 0, duration: 0.55, stagger: 0.08, delay: 0.7, ease, clearProps: 'all' });
      gsap.from('#panel-overview [data-animate="card"]', { y: 34, autoAlpha: 0, duration: 0.6, stagger: 0.12, delay: 0.95, ease, clearProps: 'all' });
      gsap.delayedCall(1.1, animateCounters);
    }

    /* ---------- Инициализация ---------- */
    const tabsValid = (id: string): boolean => tabButtons.some((b) => b.dataset.tab === id);
    renderChannels();
    renderFeed();
    renderOrders();
    renderBoard();
    renderActiveRepairs();
    const fromHash = location.hash.replace('#', '');
    setTab(tabsValid(fromHash) ? fromHash : state.tab, false, false);
    if (!reduceMotion) entrance();
  </script>
</BaseLayout>
