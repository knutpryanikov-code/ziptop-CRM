---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Заявка на подключение | ЗИПТОП">
  <main class="bg-[radial-gradient(circle_at_90%_5%,rgba(255,237,213,.9),transparent_30%),#f7f8fa]">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[.85fr_1fr] lg:gap-20 lg:py-24">
      <section class="lg:pt-10">
        <div id="role-copy">
          <p id="role-eyebrow" class="text-xs font-bold uppercase tracking-[0.25em] text-orange-600">Для продавцов</p>
          <h1 id="role-title" class="mt-4 max-w-xl text-4xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-5xl">Откройте магазин на ЗИПТОП</h1>
          <p id="role-description" class="mt-6 max-w-lg text-base leading-7 text-slate-500">Оставьте контакты и ссылки на ваши площадки — поможем подключиться к маркетплейсу.</p>
          <ol class="mt-8 space-y-3 text-sm font-semibold text-slate-600"><li class="flex items-center gap-3"><b class="grid h-7 w-7 place-items-center rounded-full bg-slate-900 text-xs text-white">1</b> Заявка</li><li class="flex items-center gap-3"><b class="grid h-7 w-7 place-items-center rounded-full bg-slate-900 text-xs text-white">2</b> Свяжемся</li><li class="flex items-center gap-3"><b class="grid h-7 w-7 place-items-center rounded-full bg-slate-900 text-xs text-white">3</b> <span id="role-step">Подключим магазин</span></li></ol>
        </div>
      </section>
      <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/10 sm:p-9">
        <form id="registration-form" class="space-y-5">
          <div><div class="flex flex-wrap items-center gap-x-3 gap-y-2"><h2 class="text-2xl font-extrabold leading-9 tracking-tight text-slate-950">Заявка на подключение</h2><div class="relative" data-role-picker><select id="applicant-type" name="applicantType" required class="sr-only"><option value="seller">Продавца</option><option value="service">Сервис центра</option><option value="master">Мастера</option></select><button id="role-picker-button" type="button" aria-haspopup="listbox" aria-expanded="false" class="group flex h-10 min-w-36 items-center justify-between gap-2 rounded-full border border-orange-200 bg-orange-50 py-1 pl-4 pr-3 text-sm font-bold text-orange-800 shadow-sm shadow-orange-900/5 transition-[border-color,background-color,box-shadow,transform] duration-150 hover:border-orange-300 hover:bg-orange-100 focus:outline-none focus:ring-4 focus:ring-orange-500/15 active:scale-[0.96]"><span id="role-picker-label">Продавца</span><svg class="h-4 w-4 shrink-0 text-orange-600 transition-transform duration-150 group-aria-expanded:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div id="role-picker-menu" role="listbox" aria-labelledby="role-picker-button" class="invisible absolute right-0 z-20 mt-2 w-52 origin-top-right translate-y-1 rounded-2xl border border-slate-200 bg-white p-1.5 opacity-0 shadow-xl shadow-slate-900/15 transition-[opacity,transform,visibility] duration-150" data-role-picker-menu><button type="button" role="option" aria-selected="true" data-role-option="seller" class="flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-left text-sm font-bold text-slate-800 transition-colors hover:bg-orange-50 focus:bg-orange-50 focus:outline-none"><span>Продавца</span><span class="text-xs font-semibold text-orange-600">Магазин</span></button><button type="button" role="option" aria-selected="false" data-role-option="service" class="flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-left text-sm font-bold text-slate-800 transition-colors hover:bg-orange-50 focus:bg-orange-50 focus:outline-none"><span>Сервис центра</span><span class="text-xs font-semibold text-orange-600">Сервис</span></button><button type="button" role="option" aria-selected="false" data-role-option="master" class="flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-left text-sm font-bold text-slate-800 transition-colors hover:bg-orange-50 focus:bg-orange-50 focus:outline-none"><span>Мастера</span><span class="text-xs font-semibold text-orange-600">Мастер</span></button></div></div></div><p class="mt-1.5 text-xs text-slate-500"><span class="text-orange-600">*</span> Обязательные поля</p></div>
          <label class="grid gap-2 text-sm font-bold text-slate-700"><span><span id="organization-label">Название магазина</span> <span class="text-orange-600" aria-hidden="true">*</span></span><input id="organization-name" name="organizationName" required maxlength="120" autocomplete="organization" placeholder="Доктор-Хаус" class="h-12 rounded-xl border border-slate-200 px-4 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" /></label>
          <div class="grid gap-4 sm:grid-cols-2"><label class="grid gap-2 text-sm font-bold text-slate-700"><span>Контактное лицо <span class="text-orange-600" aria-hidden="true">*</span></span><input name="contactName" required maxlength="120" autocomplete="name" placeholder="Иван Петров" class="h-12 rounded-xl border border-slate-200 px-4 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" /></label><label class="grid gap-2 text-sm font-bold text-slate-700"><span>Город работы <span class="text-orange-600" aria-hidden="true">*</span></span><input name="city" required maxlength="120" autocomplete="address-level2" placeholder="Новосибирск" class="h-12 rounded-xl border border-slate-200 px-4 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" /></label></div>
          <div class="grid gap-4 sm:grid-cols-2"><label class="grid gap-2 text-sm font-bold text-slate-700"><span>Почта для связи <span class="text-orange-600" aria-hidden="true">*</span></span><input name="email" type="email" required maxlength="254" autocomplete="email" placeholder="mail@example.ru" class="h-12 rounded-xl border border-slate-200 px-4 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" /></label><label class="grid gap-2 text-sm font-bold text-slate-700"><span>Телефон <span class="text-orange-600" aria-hidden="true">*</span></span><input name="phone" type="tel" required minlength="7" maxlength="30" autocomplete="tel" placeholder="+7 999 123-45-67" class="h-12 rounded-xl border border-slate-200 px-4 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" /></label></div>
          <fieldset class="grid gap-4 border-t border-slate-200 pt-5"><legend class="text-sm font-extrabold text-slate-950">О вашей работе</legend><label class="grid gap-2 text-sm font-bold text-slate-700"><span id="specialization-label">Какие товары продаёте?</span><input id="specialization" name="specialization" maxlength="240" placeholder="Запчасти для стиральных машин и холодильников" class="h-12 rounded-xl border border-slate-200 px-4 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" /></label><label class="grid gap-2 text-sm font-bold text-slate-700"><span>Сайт или страница <span class="text-xs font-normal text-slate-400">если есть</span></span><input name="profileLink" type="url" maxlength="500" placeholder="https://..." class="h-12 rounded-xl border border-slate-200 px-4 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" /></label><label class="grid gap-2 text-sm font-bold text-slate-700"><span>Комментарий <span class="text-xs font-normal text-slate-400">необязательно</span></span><textarea name="comment" rows="3" placeholder="Расскажите кратко о своём опыте или задаче" class="rounded-xl border border-slate-200 px-4 py-3 font-normal outline-none transition focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15"></textarea></label></fieldset>
          <input class="absolute -left-[9999px]" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p id="form-status" class="min-h-5 text-sm text-red-700" aria-live="polite"></p>
          <button type="submit" class="flex min-h-12 w-full items-center justify-center rounded-full bg-slate-900 px-5 text-sm font-bold text-white transition hover:bg-orange-600 active:scale-[0.96]">Отправить заявку <span class="ml-2" aria-hidden="true">→</span></button>
        </form>
        <div id="registration-success" class="hidden py-12 text-center" aria-live="polite"><span class="inline-grid h-12 w-12 place-items-center rounded-full bg-emerald-100 text-2xl text-emerald-700">✓</span><h2 class="mt-5 text-2xl font-extrabold text-slate-950">Заявка отправлена</h2><p class="mt-2 text-slate-500">Мы свяжемся с вами в самое ближайшее время.</p><a href="/market" class="mt-6 inline-flex rounded-full bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-orange-600">Открыть каталог</a></div>
      </section>
    </div>
  </main>
  <script>
    import { gsap } from 'gsap';
    const form = document.querySelector<HTMLFormElement>('#registration-form'); const status = document.querySelector<HTMLElement>('#form-status'); const success = document.querySelector<HTMLElement>('#registration-success'); const applicantType = document.querySelector<HTMLSelectElement>('#applicant-type'); const rolePickerButton = document.querySelector<HTMLButtonElement>('#role-picker-button'); const rolePickerLabel = document.querySelector<HTMLElement>('#role-picker-label'); const rolePickerMenu = document.querySelector<HTMLElement>('#role-picker-menu'); const rolePickerOptions = [...document.querySelectorAll<HTMLButtonElement>('[data-role-option]')]; const organizationLabel = document.querySelector('#organization-label'); const organizationName = document.querySelector<HTMLInputElement>('#organization-name'); const specializationLabel = document.querySelector('#specialization-label'); const specialization = document.querySelector<HTMLInputElement>('#specialization'); const roleEyebrow = document.querySelector<HTMLElement>('#role-eyebrow'); const roleTitle = document.querySelector<HTMLElement>('#role-title'); const roleDescription = document.querySelector<HTMLElement>('#role-description'); const roleStep = document.querySelector<HTMLElement>('#role-step'); const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const copy = { seller: { organization: 'Название магазина', organizationPlaceholder: 'Доктор-Хаус', specialization: 'Какие товары продаёте?', specializationPlaceholder: 'Запчасти для стиральных машин и холодильников', eyebrow: 'Для продавцов', title: 'Откройте магазин на ЗИПТОП', description: 'Оставьте контакты и ссылки на ваши площадки — поможем подключиться к маркетплейсу.', step: 'Подключим магазин' }, service: { organization: 'Название сервисного центра', organizationPlaceholder: 'СервисТех', specialization: 'Какие услуги оказываете?', specializationPlaceholder: 'Ремонт стиральных машин, холодильников', eyebrow: 'Для сервисных центров', title: 'Подключите сервисный центр', description: 'Получайте заявки, управляйте заказами и находите нужные запчасти в одной платформе.', step: 'Подключим сервисный центр' }, master: { organization: 'Ваше имя', organizationPlaceholder: 'Иван Петров', specialization: 'На какой технике специализируетесь?', specializationPlaceholder: 'Стиральные машины, посудомоечные машины', eyebrow: 'Для мастеров', title: 'Станьте мастером ЗИПТОП', description: 'Получайте новые заказы, быстро находите запчасти и развивайте своё дело вместе с нами.', step: 'Подключим профиль мастера' } };
    const setRoleCopy = (current: typeof copy[keyof typeof copy]) => { if (organizationLabel) organizationLabel.textContent = current.organization; if (organizationName) organizationName.placeholder = current.organizationPlaceholder; if (specializationLabel) specializationLabel.textContent = current.specialization; if (specialization) specialization.placeholder = current.specializationPlaceholder; if (roleEyebrow) roleEyebrow.textContent = current.eyebrow; if (roleTitle) roleTitle.textContent = current.title; if (roleDescription) roleDescription.textContent = current.description; if (roleStep) roleStep.textContent = current.step; };
    const closeRolePicker = () => { rolePickerButton?.setAttribute('aria-expanded', 'false'); rolePickerMenu?.classList.add('invisible', 'translate-y-1', 'opacity-0'); rolePickerMenu?.classList.remove('visible', 'translate-y-0', 'opacity-100'); };
    const syncRolePicker = () => { const selected = applicantType?.selectedOptions[0]?.textContent || 'Продавца'; if (rolePickerLabel) rolePickerLabel.textContent = selected; rolePickerOptions.forEach((option) => option.setAttribute('aria-selected', String(option.dataset.roleOption === applicantType?.value))); };
    const updateApplicantCopy = (animate = false) => { const current = copy[applicantType?.value as keyof typeof copy] || copy.seller; syncRolePicker(); const roleElements = [roleEyebrow, roleTitle, roleDescription, roleStep].filter((element): element is HTMLElement => Boolean(element)); if (!animate || reduceMotion || roleElements.length === 0) { setRoleCopy(current); return; } gsap.killTweensOf(roleElements); gsap.to(roleElements, { autoAlpha: 0, y: -8, duration: 0.14, stagger: 0.02, ease: 'power1.out', onComplete: () => { setRoleCopy(current); gsap.fromTo(roleElements, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.3, stagger: 0.03, ease: 'power2.out', clearProps: 'all' }); } }); };
    const roleFromHash = () => { const role = location.hash.slice(1); if (applicantType && role in copy) applicantType.value = role; updateApplicantCopy(); };
    const setApplicantRole = (role: string, animate = true) => { if (!applicantType || !(role in copy)) return; applicantType.value = role; updateApplicantCopy(animate); history.replaceState(null, '', role === 'seller' ? `${location.pathname}${location.search}` : `#${role}`); closeRolePicker(); };
    rolePickerButton?.addEventListener('click', () => { const expanded = rolePickerButton.getAttribute('aria-expanded') === 'true'; if (expanded) { closeRolePicker(); return; } rolePickerButton.setAttribute('aria-expanded', 'true'); rolePickerMenu?.classList.remove('invisible', 'translate-y-1', 'opacity-0'); rolePickerMenu?.classList.add('visible', 'translate-y-0', 'opacity-100'); }); rolePickerOptions.forEach((option) => option.addEventListener('click', () => setApplicantRole(option.dataset.roleOption || 'seller'))); document.addEventListener('click', (event) => { if (!rolePickerButton?.closest('[data-role-picker]')?.contains(event.target as Node)) closeRolePicker(); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeRolePicker(); rolePickerButton?.focus(); } }); applicantType?.addEventListener('change', () => setApplicantRole(applicantType.value)); window.addEventListener('hashchange', roleFromHash); roleFromHash();
    form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form.reportValidity()) return; const values = Object.fromEntries(new FormData(form).entries()) as Record<string, string>; if (values.website) return; values.shopName = values.organizationName; values.shopSlug = values.organizationName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'partner'; values.warehouseCity = values.city; values.warehouseSystem = values.specialization; values.ozonUrl = values.profileLink; const button = form.querySelector<HTMLButtonElement>('button[type="submit"]'); if (!button) return; button.disabled = true; button.textContent = 'Отправляем…'; try { const response = await fetch('https://functions.yandexcloud.net/d4en7gltv9mfgjshurfs', { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=UTF-8' }, body: JSON.stringify(values) }); const result = await response.json().catch(() => null); if (!response.ok || !result?.success) throw new Error(result?.message || 'Не удалось отправить заявку'); form.hidden = true; success?.classList.remove('hidden'); } catch (error) { if (status) status.textContent = error instanceof Error ? `${error.message}. Попробуйте ещё раз.` : 'Не удалось отправить заявку. Попробуйте ещё раз.'; button.disabled = false; button.textContent = 'Отправить заявку →'; } });
  </script>
</BaseLayout>
