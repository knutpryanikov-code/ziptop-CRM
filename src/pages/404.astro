---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — страница не найдена | ЗИПТОП">
  <main class="not-found">
    <div class="mx-auto grid min-h-[calc(100vh-8rem)] max-w-7xl items-end gap-6 px-4 py-9 sm:px-6 lg:grid-cols-[minmax(0,.9fr)_minmax(350px,.8fr)] lg:gap-7 lg:py-11">
      <section class="not-found__copy max-w-xl pb-0 text-center lg:pb-11 lg:text-left">
        <p class="m-0 text-[clamp(68px,11vw,142px)] font-black leading-[.85] tracking-[-.09em] text-orange-600">404</p>
        <h1 class="mt-4 text-balance text-4xl font-extrabold leading-none tracking-[-.055em] text-slate-950 sm:text-5xl">Страница не найдена</h1>
        <p class="mx-auto mt-4 max-w-lg text-pretty text-base leading-7 text-slate-500 sm:text-lg lg:mx-0">Похоже, эта деталь страницы потерялась. Попробуйте воспользоваться поиском!</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a href="/каталог/" class="inline-flex min-h-11 items-center justify-center rounded-full bg-orange-500 px-6 text-sm font-bold text-white shadow-lg shadow-orange-500/25 transition hover:bg-orange-600">Открыть каталог</a>
          <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-200 bg-white px-6 text-sm font-bold text-slate-700 transition hover:border-orange-200 hover:text-orange-600">На главную</a>
        </div>
      </section>
      <img class="not-found__cat mx-auto block w-full max-w-[550px] self-end drop-shadow-[0_22px_23px_rgba(15,23,42,.16)] lg:justify-self-end" src="/404-cat-spare-parts.png" alt="Кот рядом с коробкой запчастей" width="1254" height="1254" />
    </div>
  </main>
</BaseLayout>

<style>
  .not-found { overflow: hidden; background: radial-gradient(circle at 85% 42%, #fff0df 0, transparent 32%), #f7f8fa; }
  @media (max-width: 1023px) { .not-found__cat { max-width: 430px; margin-top: -15px; } }
  @media (max-width: 560px) { .not-found__cat { max-width: 330px; margin-top: -5px; } }
</style>
