<button type="button" class="site-city-selector" data-city-toggle aria-label="Выбрать город доставки"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg><span data-city-current>Новосибирск</span></button>
<script>
  const key = 'ziptop_city';
  const readCity = () => { try { return localStorage.getItem(key) || 'Новосибирск'; } catch { return 'Новосибирск'; } };
  const render = () => document.querySelectorAll<HTMLElement>('[data-city-current]').forEach((node) => node.textContent = readCity());
  const initCitySelector = () => {
    // The header is replaced by Astro's client router. Read storage again for
    // the new markup before making the city control visible.
    render();
    requestAnimationFrame(() => requestAnimationFrame(() => document.querySelector<HTMLElement>('.main-site-header')?.classList.add('is-header-ready')));
  };
  initCitySelector();
  document.addEventListener('astro:page-load', initCitySelector);
  window.addEventListener('ziptop:city-changed', render);
  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('[data-city-toggle]')) return;
    event.preventDefault();
    void import('../scripts/city-modal').then(({ openCityModal }) => openCityModal());
  });
</script>

<style is:global>
  .site-city-selector{display:inline-flex;min-height:40px;align-items:center;gap:7px;border:0;border-radius:9px;padding:0 10px;background:transparent;color:#64748b;font:700 13px/1 inherit;white-space:nowrap;cursor:pointer;transition:background-color .15s ease,color .15s ease}.site-city-selector:hover{background:#fff7ed;color:#ea580c}.site-city-selector svg{color:#f97316}
</style>
