---
interface MarketProduct {
  sku: string;
  name: string;
  category: string;
  price: number;
  oldPrice?: number | null;
  image: string;
  url: string;
  rating?: number | string;
  reviews?: number;
  tag?: string | null;
  stock?: string | null;
  delivery?: string;
}

const showcaseSkus = ['ZWO3104 -71601102', 'SWF-P10-DC68-30335E', 'PolkaBU', '700459bu', 'SKT2002EU/07-8607000172', 'ADP132AV/WP-339404013956', 'C6VM3(X)R-611108113', 'HB86E560/01-G67140092', '4055132304', 'A758889', 'A655794', '5332184900'];
let products: MarketProduct[] = [];

try {
  const response = await fetch('https://xn--g1acsdbq.xn--p1ai/market/catalog-search.json', { signal: AbortSignal.timeout(15_000) });
  const payload = await response.json() as { products?: MarketProduct[] };
  const available = payload.products ?? [];
  const bySku = new Map(available.map((product) => [product.sku, product]));
  const selected = showcaseSkus.map((sku) => bySku.get(sku)).filter((product): product is MarketProduct => Boolean(product));
  products = [...selected, ...available.filter((product) => !selected.some((selectedProduct) => selectedProduct.sku === product.sku))].slice(0, 12);
} catch (error) {
  console.warn('Unable to load the market showcase:', error);
}

const formatPrice = new Intl.NumberFormat('ru-RU');
---

<section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6" aria-labelledby="market-showcase-title">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-orange-600">На витрине</p>
      <h2 id="market-showcase-title" class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">Ходовые запчасти</h2>
    </div>
    <a href="/market" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 transition hover:text-orange-600">Открыть каталог <span aria-hidden="true">→</span></a>
  </div>

  {products.length > 0 ? (
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
      {products.map((product, index) => (
        <article class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-orange-200 hover:shadow-xl hover:shadow-orange-500/10">
          <a href={product.url} class="relative flex h-40 items-center justify-center bg-white p-3 sm:h-44" aria-label={`Открыть ${product.name}`}>
            <img src={product.image} alt={product.name} loading={index < 6 ? 'eager' : 'lazy'} decoding="async" class="h-full w-full rounded-xl object-contain outline outline-1 outline-black/10" />
            {product.tag && <b class="absolute left-3 top-3 rounded-md bg-pink-600 px-2 py-1 text-[10px] font-bold text-white">{product.tag}</b>}
          </a>
          <div class="flex min-h-56 flex-1 flex-col p-3">
            <p class="line-clamp-1 text-[10px] font-bold uppercase tracking-wide text-orange-600">{product.category}</p>
            <a href={product.url} class="mt-1 line-clamp-3 text-xs font-bold leading-5 text-slate-900 transition hover:text-orange-600">{product.name}</a>
            <p class="mt-1 truncate text-[10px] font-semibold text-slate-400">Арт. {product.sku}</p>
            <p class="mt-2 text-xs text-slate-400"><span class="text-amber-500">★</span> {product.rating || '4.8'} · {product.reviews || 0} отзывов</p>
            <div class="mt-auto pt-3">
              <div class="flex items-center justify-between gap-3"><p class="font-extrabold tracking-tight text-slate-950">{formatPrice.format(product.price)}&nbsp;₽</p><button type="button" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-600 text-white shadow-sm transition hover:bg-orange-700 active:scale-[0.96]" data-add-to-cart data-sku={product.sku} data-name={product.name} data-price={product.price} data-old-price={product.oldPrice || ''} data-image={product.image} data-category={product.category} aria-label={`Купить «${product.name}»`} title="Купить"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg></button></div>
              {product.delivery && <p class="mt-1 text-[10px] leading-4 text-emerald-700">{product.delivery} в пункте выдачи</p>}
            </div>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Каталог временно обновляется. <a href="/market" class="font-semibold text-orange-600">Открыть каталог</a></p>
  )}
</section>
