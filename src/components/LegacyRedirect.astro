---
interface Props {
  destination: string;
}

const { destination } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Перенаправление — ЗИПТОП</title>
  </head>
  <body>
    <script define:vars={{ destination }}>window.location.replace(destination + window.location.search + window.location.hash);</script>
    <a href={destination}>Перейти на актуальную страницу</a>
  </body>
</html>
